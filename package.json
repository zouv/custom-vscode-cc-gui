{
  "name": "custom-vscode-cc-gui",
  "displayName": "CC GUI (Custom)",
  "description": "CC GUI (Custom) — independent open-source GUI for Claude Code, Codex, OpenCode, Kimi, Grok and more (unofficial custom fork)",
  "version": "0.1.5-custom.1",
  "publisher": "zouv",
  "author": {
    "name": "MossX"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hpstream/vscode-cc-gui"
  },
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "AI"],
  "keywords": [
    "ccgui",
    "CCGUI",
    "cc-gui",
    "cc gui",
    "claude",
    "claude-code",
    "claude code",
    "codex",
    "opencode",
    "open code",
    "kimi",
    "kimi-code",
    "kimi code",
    "grok",
    "pi",
    "ai",
    "llm",
    "agent",
    "chat",
    "gui",
    "anthropic",
    "openai",
    "chatgpt",
    "coding-assistant",
    "ai-assistant",
    "vscode-ai",
    "claude cli",
    "codex cli",
    "prompt",
    "multi-agent"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ccgc-activity",
          "title": "%ccgc.viewsContainers.activitybar.title%",
          "icon": "media/icon-activity.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "ccgc-secondary",
          "title": "%ccgc.viewsContainers.secondarySidebar.title%",
          "icon": "media/icon-outline.svg"
        }
      ]
    },
    "views": {
      "ccgc-activity": [
        {
          "type": "webview",
          "id": "ccgc.mainView",
          "name": "%ccgc.views.mainView.name%"
        }
      ],
      "ccgc-secondary": [
        {
          "type": "webview",
          "id": "ccgc.secondaryView",
          "name": "%ccgc.views.secondaryView.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "ccgc.openPanel",
        "title": "%ccgc.command.openPanel.title%",
        "category": "%ccgc.command.category%",
        "icon": {
          "light": "media/icon-outline.svg",
          "dark": "media/icon-outline.svg"
        }
      },
      {
        "command": "ccgc.newSession",
        "title": "%ccgc.command.newSession.title%",
        "category": "%ccgc.command.category%",
        "icon": "$(add)"
      },
      {
        "command": "ccgc.renameActiveChatTab",
        "title": "%ccgc.command.renameActiveChatTab.title%",
        "category": "%ccgc.command.category%",
        "icon": "$(edit)"
      },
      {
        "command": "ccgc.openDevTools",
        "title": "%ccgc.command.openDevTools.title%",
        "category": "%ccgc.command.category%",
        "icon": "$(debug-console)"
      },
      {
        "command": "ccgc.hidePanel",
        "title": "%ccgc.command.hidePanel.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.sendSelection",
        "title": "%ccgc.command.sendSelection.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.copySelectionReference",
        "title": "%ccgc.command.copySelectionReference.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.sendFilePath",
        "title": "%ccgc.command.sendFilePath.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.generateCommitMessage",
        "title": "%ccgc.command.generateCommitMessage.title%",
        "category": "%ccgc.command.category%",
        "icon": "$(git-commit)"
      },
      {
        "command": "ccgc.quickFixWithClaude",
        "title": "%ccgc.command.quickFixWithClaude.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.saveSessionTemplate",
        "title": "%ccgc.command.saveSessionTemplate.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.createSessionFromTemplate",
        "title": "%ccgc.command.createSessionFromTemplate.title%",
        "category": "%ccgc.command.category%"
      },
      {
        "command": "ccgc.runSetupWizard",
        "title": "%ccgc.command.runSetupWizard.title%",
        "category": "%ccgc.command.category%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "ccgc.openPanel",
          "group": "navigation@100"
        }
      ],
      "editor/context": [
        {
          "command": "ccgc.sendSelection",
          "when": "editorHasSelection",
          "group": "ccgc@1"
        },
        {
          "command": "ccgc.copySelectionReference",
          "when": "editorHasSelection",
          "group": "ccgc@2"
        },
        {
          "command": "ccgc.sendFilePath",
          "group": "ccgc@3"
        }
      ],
      "explorer/context": [
        {
          "command": "ccgc.sendFilePath",
          "group": "ccgc@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "ccgc.sendFilePath",
          "group": "ccgc@1"
        }
      ],
      "scm/title": [
        {
          "command": "ccgc.generateCommitMessage",
          "group": "navigation@50",
          "when": "scmProvider == git"
        },
        {
          "command": "ccgc.generateCommitMessage",
          "group": "1_ccgc@1",
          "when": "scmProvider == git"
        }
      ],
      "view/title": [
        {
          "command": "ccgc.newSession",
          "when": "view == ccgc.mainView || view == ccgc.secondaryView",
          "group": "navigation"
        },
        {
          "command": "ccgc.openDevTools",
          "when": "ccgc.enableDebugLog && (view == ccgc.mainView || view == ccgc.secondaryView)",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ccgc.sendSelection",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "ccgc.quickFixWithClaude",
        "key": "ctrl+shift+q",
        "mac": "cmd+shift+q",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "%ccgc.configuration.title%",
      "properties": {
        "ccgc.nodePath": {
          "type": "string",
          "default": "",
          "description": "%ccgc.configuration.nodePath.description%"
        },
        "ccgc.autoSyncActiveFile": {
          "type": "boolean",
          "default": true,
          "description": "%ccgc.configuration.autoSyncActiveFile.description%"
        },
        "ccgc.enableDebugLog": {
          "type": "boolean",
          "default": false,
          "description": "%ccgc.configuration.enableDebugLog.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run build:ext && npm run build:webview",
    "build:debug": "npm run build:ext:debug && npm run build:webview",
    "build:ext": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify",
    "build:ext:debug": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap",
    "build:webview": "cd webview && npm run build",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch",
    "dev": "npm run watch",
    "dev:host": "node CUSTOMIZATIONS/scripts/dev-host.mjs",
    "test:ext": "node --experimental-strip-types --no-warnings --test 'src/__tests__/**/*.test.mts'"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "~5.3.0"
  }
}
